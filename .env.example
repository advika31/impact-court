# Copy this file to .env and fill in real values. Never commit .env itself.

# If running the API via docker compose, use "db" as the host (matches the
# service name in docker-compose.yml). If running uvicorn directly on your
# machine (not in Docker), use "localhost" instead.
DATABASE_URL=postgresql://impact:impact@db:5432/impact_court

# From your Cloudinary console (Dashboard tab)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# From https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key
CLAIMS_LLM_MODEL=claude-sonnet-4-5

# Run `python generate_keys.py` and paste the printed value here
LEDGER_PRIVATE_KEY=
